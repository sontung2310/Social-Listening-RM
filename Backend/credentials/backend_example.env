SECRET_KEY=dev-only-secret
DEBUG=1
HOST=127.0.0.1
PORT=8000

NEWSAPI_KEY=your_newsapi_key_here # NewsAPI.org — used by newsfeed card fallback
SERPAPI_KEY=your_serpapi_key_here # SerpAPI — Google Trends for trending cards

GOOGLE_TRENDS_GEO=AU # Default geographic region for Google Trends (AU = Australia)
GOOGLE_TRENDS_TZ=-660 # Timezone offset for Google Trends (e.g. -660 for AEST)

# Article/AI database
ARTICLE_MONGODB_URI=mongodb+srv://<username>:<password>@<article-cluster>.mongodb.net/?retryWrites=true&w=majority
ARTICLE_MONGODB_DBNAME=pace_database

# Separate RM dashboard database for influencer-list replacement
DASHBOARD_DATABASE_HOST=<dashboard-cluster>.mongodb.net
DASHBOARD_DATABASE_NAME=<dashboard-database-name>
DASHBOARD_DATABASE_USERNAME=<dashboard-mongo-user>
DASHBOARD_DATABASE_PASSWORD=<dashboard-mongo-password>

# DCT status API (influencer status is authoritative in Data-Crawler-Task)
DCT_API_BASE_URL=http://127.0.0.1:8001
DCT_API_KEY=
DCT_API_TIMEOUT_SECONDS=10

# AWS credentials (standard names — boto3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2

# SQS queues
SQS_COMMAND_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/622235678838/social_listening_data_crawling
SQS_AI_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/622235678838/social_listening_crawling_response
SQS_DLQ_URL=https://sqs.ap-southeast-2.amazonaws.com/622235678838/social_listening_data_crawling_dlq
SQS_WAIT_TIME_SECONDS=20

# AI worker queue — "sim" = sample_messages/; "sqs" = SQS_AI_QUEUE_URL
AI_QUEUE_BACKEND=sqs
AI_WORKER_MAX_MESSAGES=10
AI_WORKER_IDLE_SLEEP_SECONDS=1
